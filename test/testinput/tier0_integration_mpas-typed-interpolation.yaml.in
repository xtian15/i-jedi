geometry:
  geometry_type: mpas
  atlas compiler identity: @IJEDI_MPAS_ATLAS_COMPILER_IDENTITY@
  python executable: "@IJEDI_MPAS_PYTHON@"
  runtime receipt path: "@IJEDI_MPAS_RUNTIME_RECEIPT@"
  wheel path: "@IJEDI_MPAS_WHEEL@"
  wheel sha256: @IJEDI_MPAS_WHEEL_SHA256@
  init path: "@IJEDI_MPAS_CASE_DIR@/x1.10242.init.nc"
  grid path: "@IJEDI_MPAS_CASE_DIR@/x1.10242.grid.nc"
  namelist path: "@IJEDI_MPAS_CASE_DIR@/namelist.atmosphere"
  horizontal geometry receipt: @IJEDI_MPAS_HORIZONTAL_GEOMETRY_RECEIPT@
  static vertical geometry receipt: @IJEDI_MPAS_STATIC_VERTICAL_GEOMETRY_RECEIPT@
  geometry bundle receipt: @IJEDI_MPAS_GEOMETRY_BUNDLE_RECEIPT@
  configuration receipt: @IJEDI_MPAS_CONFIGURATION_RECEIPT@
  state schema digest: @IJEDI_MPAS_STATE_SCHEMA_DIGEST@
  python version: @IJEDI_MPAS_PYTHON_VERSION@
  torch version: @IJEDI_MPAS_TORCH_VERSION@
  numpy version: @IJEDI_MPAS_NUMPY_VERSION@
  netcdf4 version: @IJEDI_MPAS_NETCDF4_VERSION@
  mpas-pytorch version: @IJEDI_MPAS_PACKAGE_VERSION@
  mpas-pytorch source commit: @IJEDI_MPAS_SOURCE_COMMIT@
  torch intraop threads: 1
  torch interop threads: 1
  vertical coordinate source: level index

initial condition:
  date: 2026-07-17T06:00:00Z
  state variables: [u, w, scalars]

model:
  name: MPAS-PyTorch
  time step: PT12M
  model variables: [u, w, scalars]
model aux control: {}

local interpolation: {}
locations path: "@IJEDI_MPAS_ANALYSIS_LOCATIONS@"
typed variables: [air_pressure, air_pressure_levels, air_pressure_at_surface,
                  air_temperature, dry_air_density,
                  water_vapor_mixing_ratio_wrt_dry_air,
                  water_vapor_mixing_ratio_wrt_moist_air,
                  eastward_wind, northward_wind,
                  height_above_mean_sea_level,
                  height_above_mean_sea_level_levels,
                  height_above_mean_sea_level_at_surface]
output values: "@IJEDI_MPAS_P2_OUTPUT@"
output metrics: "@IJEDI_MPAS_P2_METRICS@"
atlas cache output: "@IJEDI_MPAS_P2_OUTPUT@.atlas-cache.json"
analysis bridge output: "@IJEDI_MPAS_ANALYSIS_OUTPUT@"
handle probe mode: "@IJEDI_MPAS_HANDLE_PROBE_MODE@"
state probe mode: "@IJEDI_MPAS_STATE_PROBE_MODE@"
partial transform probe: @IJEDI_MPAS_PARTIAL_PROBE@
native P socket probe: @IJEDI_MPAS_NATIVE_SOCKET_PROBE@
